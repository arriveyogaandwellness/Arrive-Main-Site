# Server Configuration
PORT=3000
NODE_ENV=production

# Stripe Merchant Account Configuration
# Get your keys from https://dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY=pk_test_sample_key_replace_with_yours
STRIPE_SECRET_KEY=sk_test_sample_key_replace_with_yours

# Stripe Webhook Secret (optional, for automated webhook events)
STRIPE_WEBHOOK_SECRET=whsec_sample_secret

# Base URL for redirects (used by Stripe Checkout)
# For local development: http://localhost:3000
# For live Railway deployment: https://your-app-name.up.railway.app
BASE_URL=http://localhost:3000
